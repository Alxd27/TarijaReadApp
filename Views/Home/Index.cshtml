@{
    ViewData["Title"] = "TarijaRead - Panel Principal";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5 text-primary">📚 TarijaRead</h1>
        <p class="text-muted">Sistema de Gestión de Biblioteca</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Categorías</h5>
                    <p class="card-text text-muted">Gestiona las categorías de libros</p>
                    <a asp-controller="Categorias" asp-action="Index" class="btn btn-primary w-100">Ir a Categorías</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Libros</h5>
                    <p class="card-text text-muted">Catálogo de libros registrados</p>
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-primary w-100">Ir a Libros</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Ejemplares</h5>
                    <p class="card-text text-muted">Copias físicas de cada libro</p>
                    <a asp-controller="Ejemplares" asp-action="Index" class="btn btn-primary w-100">Ir a Ejemplares</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Socios</h5>
                    <p class="card-text text-muted">Usuarios que solicitan préstamos</p>
                    <a asp-controller="Socios" asp-action="Index" class="btn btn-primary w-100">Ir a Socios</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Préstamos</h5>
                    <p class="card-text text-muted">Registro de salidas y devoluciones</p>
                    <a asp-controller="Prestamos" asp-action="Index" class="btn btn-primary w-100">Ir a Préstamos</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Multas</h5>
                    <p class="card-text text-muted">Penalizaciones por mora</p>
                    <a asp-controller="Multas" asp-action="Index" class="btn btn-primary w-100">Ir a Multas</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Usuarios</h5>
                    <p class="card-text text-muted">Personal administrativo y bibliotecarios</p>
                    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-primary w-100">Ir a Usuarios</a>
                </div>
            </div>
        </div>
    </div>
</div>